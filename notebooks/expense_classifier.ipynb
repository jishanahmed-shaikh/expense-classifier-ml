    "---\n",
    "## Appendix — Inference Utility Function\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# PREDICT ACCOUNT NAME FOR A NEW EXPENSE LINE ITEM\n",
    "#\n",
    "# Loads the saved model bundle and runs the same feature pipeline used in training.\n",
    "# Returns the top-k predicted account names with their probabilities.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def predict_account_name(\n",
    "    ITEM_NAME: str,\n",
    "    ITEM_DESCRIPTION: str = '',\n",
    "    VENDOR_ID: str = '',\n",
    "    AMOUNT: float = 0.0,\n",
    "    TOP_K: int = 3\n",
    ") -> list:\n",
    "    \"\"\"Predict the accountName for a new expense record.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    ITEM_NAME        : expense item name string\n",
    "    ITEM_DESCRIPTION : expense item description (can be same as ITEM_NAME)\n",
    "    VENDOR_ID        : vendor identifier string\n",
    "    AMOUNT           : transaction amount (can be negative)\n",
    "    TOP_K            : how many top predictions to return\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    List of (account_name, probability) tuples sorted by probability descending.\n",
    "    If the model does not support predict_proba, returns (account_name, None).\n",
    "    \"\"\"\n",
    "    # Load saved artifacts\n",
    "    BUNDLE = joblib.load(MODEL_SAVE_PATH)\n",
    "\n",
    "    SAVED_MODEL          = BUNDLE['model']\n",
    "    SAVED_TFIDF_WORD     = BUNDLE['tfidf_word']\n",
    "    SAVED_TFIDF_CHAR     = BUNDLE['tfidf_char']\n",
    "    SAVED_SCALER         = BUNDLE['numeric_scaler']\n",
    "    SAVED_LABEL_ENC      = BUNDLE['label_encoder']\n",
    "    SAVED_VENDOR_IDS     = BUNDLE['top_vendor_ids']\n",
    "\n",
    "    # Text features\n",
    "    CLEANED_TEXT   = clean_expense_text(ITEM_NAME, ITEM_DESCRIPTION)\n",
    "    TEXT_WORD_VEC  = SAVED_TFIDF_WORD.transform([CLEANED_TEXT])\n",
    "    TEXT_CHAR_VEC  = SAVED_TFIDF_CHAR.transform([CLEANED_TEXT])\n",
    "    TEXT_VEC       = hstack([TEXT_WORD_VEC, TEXT_CHAR_VEC])\n",
    "\n",
    "    # Numeric features\n",
    "    ABS_AMOUNT     = max(abs(AMOUNT), 0.01)\n",
    "    LOG_AMT        = np.log1p(ABS_AMOUNT)\n",
    "    IS_NEG         = float(AMOUNT < 0)\n",
    "    AMT_BKT        = 5.0   # default to median bucket for unknown amounts\n",
    "\n",
    "    V_LOG_FREQ     = np.log1p(VENDOR_FREQ_MAP.get(VENDOR_ID, 1))\n",
    "    try:\n",
    "        V_ENCODED  = float(VENDOR_LABEL_ENCODER.transform([VENDOR_ID])[0])\n",
    "    except ValueError:\n",
    "        V_ENCODED  = 0.0   # unseen vendor — use fallback\n",
    "\n",
    "    NUM_RAW        = np.array([[V_LOG_FREQ, V_ENCODED, IS_NEG, LOG_AMT, AMT_BKT]])\n",
    "    NUM_SCALED     = csr_matrix(SAVED_SCALER.transform(NUM_RAW))\n",
    "\n",
    "    # Vendor one-hot\n",
    "    VENDOR_OH_VEC  = build_vendor_onehot_matrix(pd.Series([VENDOR_ID]), SAVED_VENDOR_IDS)\n",
    "\n",
    "    X_INFER        = hstack([TEXT_VEC, NUM_SCALED, VENDOR_OH_VEC])\n",
    "\n",
    "    # Predict\n",
    "    if hasattr(SAVED_MODEL, 'predict_proba'):\n",
    "        PROBA_ARRAY    = SAVED_MODEL.predict_proba(X_INFER)[0]\n",
    "        TOP_IDX        = PROBA_ARRAY.argsort()[-TOP_K:][::-1]\n",
    "        return [(SAVED_LABEL_ENC.classes_[I], round(float(PROBA_ARRAY[I]), 4)) for I in TOP_IDX]\n",
    "    else:\n",
    "        # LinearSVC does not have predict_proba; return top prediction only\n",
    "        PRED_LABEL     = SAVED_MODEL.predict(X_INFER)[0]\n",
    "        PRED_NAME      = SAVED_LABEL_ENC.inverse_transform([PRED_LABEL])[0]\n",
    "        return [(PRED_NAME, None)]\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# DEMO PREDICTIONS\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "DEMO_EXPENSE_RECORDS = [\n",
    "    ('monthly subscription fee',      'slack monthly plan',       '',   99.0),\n",
    "    ('legal services retainer',       'legal services retainer',  '', 5000.0),\n",
    "    ('recruiter commission',          'hiring agency fee',         '', 3500.0),\n",
    "    ('office supplies',               '',                          '',  250.0),\n",
    "    ('cloud infrastructure monthly',  'aws usage',                 '', 8000.0),\n",
    "]\n",
    "\n",
    "print('Demo Predictions:')\n",
    "print('=' * 65)\n",
    "for DEMO_NAME, DEMO_DESC, DEMO_VENDOR, DEMO_AMT in DEMO_EXPENSE_RECORDS:\n",
    "    DEMO_RESULT = predict_account_name(DEMO_NAME, DEMO_DESC, DEMO_VENDOR, DEMO_AMT)\n",
    "    print(f'  Item     : {DEMO_NAME}')\n",
    "    for ACCOUNT, PROB in DEMO_RESULT:\n",
    "        PROB_STR = f'{PROB:.2%}' if PROB is not None else 'n/a'\n",
    "        print(f'    {PROB_STR:8s}  {ACCOUNT}')\n",
    "    print()\n"
   ]
  }
