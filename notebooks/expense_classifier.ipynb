   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# FULL CLASSIFICATION REPORT  — precision, recall, F1 per class\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "TRUE_CLASS_NAMES = TARGET_LABEL_ENCODER.inverse_transform(LABELS_TEST)\n",
    "PRED_CLASS_NAMES = TARGET_LABEL_ENCODER.inverse_transform(BEST_PREDICTIONS)\n",
    "\n",
    "print(f'Classification Report — {BEST_MODEL_NAME}')\n",
    "print('=' * 70)\n",
    "print(classification_report(\n",
    "    TRUE_CLASS_NAMES, PRED_CLASS_NAMES, zero_division=0\n",
    "))\n"
   ]
