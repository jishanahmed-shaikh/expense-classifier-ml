    "print(f'Clean dataset shape : {CLEAN_DF.shape}')\n",
    "print(f'Unique accountNames : {CLEAN_DF[\"accountName\"].nunique()}')\n",
    "print(f'Unique vendors      : {CLEAN_DF[\"vendorId\"].nunique()}')\n",
    "CLEAN_DF.dtypes\n"
