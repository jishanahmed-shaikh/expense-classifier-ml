    "RECORDS_FROM_SINGLE     = CLEAN_DF['vendorId'].isin(SINGLE_ACCT_VENDOR_IDS).sum()\n",
    "print(f'Records from single-account vendors   : {RECORDS_FROM_SINGLE:,}  ({RECORDS_FROM_SINGLE/len(CLEAN_DF)*100:.1f}%)')\n",
    "print()\n",
    "print('Distribution of unique accounts per vendor (top counts):')\n",
    "print(VENDOR_UNIQUE_ACCOUNTS.value_counts().head(8).to_string())\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3.4 Key EDA Insights\n",
    "\n",
    "| Observation | Implication |\n",
    "|---|---|\n",
    "| 103 classes; dominant class has 1,179 samples | Severe imbalance — must use stratified splits and class-weight balancing |\n",
    "| 30+ classes have ≤ 5 samples | Rare classes are near-impossible to learn; macro-F1 will be lower than accuracy |\n",
    "| ~83% of records: `itemName == itemDescription` | Combined text deduplication avoids artificial term boosting |\n",
    "| Leading 4-digit codes in descriptions (e.g. `0226`) | Booking-period noise — strip before vectorising |\n",
    "| ~60% of vendors always map to a single account | Vendor one-hot is highly predictive; one-hot encoding all vendors is the key insight |\n",
    "| `accountId` is 1:1 with `accountName` | Direct leakage — excluded from all features |\n",
    "| Wide amount range, some negatives | Log-transform + is-negative flag captures both scale and sign |\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 4. Feature Engineering\n",
    "\n",
    "Three complementary feature groups are combined into a single sparse matrix:\n",
    "\n",
    "| Group | What | Why |\n",
    "|---|---|---|\n",
    "| Text (word) | TF-IDF (1–2 grams) on cleaned description | Captures vocabulary like *subscription*, *salary*, *audit fee* |\n",
    "| Text (char) | TF-IDF (2–4 char n-grams) | Catches morphological patterns even in short/coded descriptions |\n",
    "| Vendor | One-hot for top-N vendors | Vendor identity is deterministic for ~60% of records |\n",
    "| Amount | Log-amount, amount bucket, is-negative flag | Secondary signal for distinguishing expense types |\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# TEXT CLEANING FUNCTION\n",
    "#\n",
    "# What we do:\n",
    "#   1. Strip leading booking-period codes like \"0226\", \"1225-\" (noise)\n",
    "#   2. Lower-case everything\n",
    "#   3. If name and description are the same, keep only one copy\n",
    "#   4. Remove non-alphanumeric characters\n",
    "#   5. Collapse multiple spaces\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def clean_expense_text(ITEM_NAME: str, ITEM_DESCRIPTION: str) -> str:\n",
    "    \"\"\"Combine and clean itemName + itemDescription into a single text string.\"\"\"\n",
    "    ITEM_NAME        = str(ITEM_NAME).strip()\n",
    "    ITEM_DESCRIPTION = str(ITEM_DESCRIPTION).strip()\n",
    "\n",
    "    # Strip leading 4-digit date/reference codes  (e.g. \"0226 \", \"1225-\")\n",
    "    ITEM_NAME        = re.sub(r'^\\d{4}[-\\s]+', '', ITEM_NAME)\n",
    "    ITEM_DESCRIPTION = re.sub(r'^\\d{4}[-\\s]+', '', ITEM_DESCRIPTION)\n",
    "\n",
    "    ITEM_NAME        = ITEM_NAME.lower()\n",
    "    ITEM_DESCRIPTION = ITEM_DESCRIPTION.lower()\n",
    "\n",
    "    # Avoid duplicating the same text when both fields are identical\n",
    "    if ITEM_NAME == ITEM_DESCRIPTION or not ITEM_DESCRIPTION:\n",
    "        COMBINED = ITEM_NAME\n",
    "    else:\n",
    "        COMBINED = ITEM_NAME + ' | ' + ITEM_DESCRIPTION\n",
    "\n",
    "    # Keep only alphanumeric characters and spaces\n",
    "    COMBINED = re.sub(r'[^a-z0-9 |]', ' ', COMBINED)\n",
    "    COMBINED = re.sub(r'\\s+', ' ', COMBINED).strip()\n",
    "    return COMBINED\n",
    "\n",
    "\n",
    "CLEAN_DF['COMBINED_TEXT'] = CLEAN_DF.apply(\n",
    "    lambda ROW: clean_expense_text(ROW['itemName'], ROW['itemDescription']),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "print('Text cleaning done. Sample output:')\n",
    "for _, ROW in CLEAN_DF.sample(4, random_state=RANDOM_SEED).iterrows():\n",
    "    print(f'  [{ROW[\"accountName\"]}]')\n",
    "    print(f'  -> {ROW[\"COMBINED_TEXT\"][:80]}')\n",
    "    print()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# AMOUNT FEATURES\n",
    "#\n",
    "# log_amount   : log(1 + |amount|)  — compresses the wide range into a usable scale\n",
    "# is_negative  : flag for credit / reversal entries\n",
    "# amount_bucket: 10 quantile-based bins of log_amount — gives tree models clean splits\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "AMOUNT_RAW     = CLEAN_DF['itemTotalAmount'].astype(float)\n",
    "IS_NEGATIVE    = (AMOUNT_RAW < 0).astype(float)\n",
    "LOG_AMOUNT     = np.log1p(AMOUNT_RAW.abs().clip(lower=0.01))\n",
    "AMOUNT_BUCKET  = pd.qcut(LOG_AMOUNT, q=10, labels=False, duplicates='drop').fillna(0).astype(float)\n",
    "\n",
    "AMOUNT_FEATURES_DF = pd.DataFrame({\n",
    "    'IS_NEGATIVE'  : IS_NEGATIVE,\n",
    "    'LOG_AMOUNT'   : LOG_AMOUNT,\n",
    "    'AMOUNT_BUCKET': AMOUNT_BUCKET,\n",
    "}, index=CLEAN_DF.index)\n",
    "\n",
    "print('Amount features shape:', AMOUNT_FEATURES_DF.shape)\n",
    "print(AMOUNT_FEATURES_DF.describe().round(3).to_string())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# VENDOR FEATURES\n",
    "#\n",
    "# vendor_log_freq : log(1 + frequency) — how active this vendor is\n",
    "# vendor_encoded  : integer-encoded vendorId for tree-based models\n",
    "#\n",
    "# One-hot encoding of the top N vendors is built after the train/test split\n",
    "# (to avoid leaking test-set vendor frequencies into the training data)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "VENDOR_FREQ_MAP  = CLEAN_DF['vendorId'].value_counts()\n",
    "VENDOR_LOG_FREQ  = np.log1p(CLEAN_DF['vendorId'].map(VENDOR_FREQ_MAP).fillna(1))\n",
    "\n",
    "VENDOR_LABEL_ENCODER    = LabelEncoder()\n",
    "VENDOR_ENCODED          = VENDOR_LABEL_ENCODER.fit_transform(CLEAN_DF['vendorId'].astype(str))\n",
    "\n",
    "VENDOR_NUMERIC_DF = pd.DataFrame({\n",
    "    'VENDOR_LOG_FREQ': VENDOR_LOG_FREQ.values,\n",
    "    'VENDOR_ENCODED' : VENDOR_ENCODED,\n",
    "}, index=CLEAN_DF.index)\n",
    "\n",
    "print(f'Vendor frequency range : {VENDOR_FREQ_MAP.min()} – {VENDOR_FREQ_MAP.max()}')\n",
    "print(f'Vendor encoded range   : {VENDOR_ENCODED.min()} – {VENDOR_ENCODED.max()}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# TARGET ENCODING\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "TARGET_LABEL_ENCODER = LabelEncoder()\n",
    "CLEAN_DF['LABEL']    = TARGET_LABEL_ENCODER.fit_transform(CLEAN_DF['accountName'])\n",
    "\n",
    "NUM_CLASSES = len(TARGET_LABEL_ENCODER.classes_)\n",
    "print(f'Number of target classes : {NUM_CLASSES}')\n",
    "print(f'First 5 class labels     : {TARGET_LABEL_ENCODER.classes_[:5].tolist()}')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 5. Model Training and Selection\n",
    "\n",
    "### 5.1 Train / Test Split\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# STRATIFIED TRAIN / TEST SPLIT\n",
    "#\n",
    "# Classes with only 1 sample cannot be stratified (scikit-learn requires at\n",
    "# least 2 samples per class). We group them under a single '_rare_' label\n",
    "# for stratification, ensuring they all end up in training.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "CLASS_SAMPLE_COUNTS  = CLEAN_DF['accountName'].value_counts()\n",
    "STRATIFY_LABEL       = CLEAN_DF['accountName'].apply(\n",
    "    lambda NAME: '_rare_' if CLASS_SAMPLE_COUNTS[NAME] == 1 else NAME\n",
    ")\n",
    "\n",
    "ALL_TEXT    = CLEAN_DF['COMBINED_TEXT']\n",
    "ALL_NUMERIC = pd.concat([VENDOR_NUMERIC_DF, AMOUNT_FEATURES_DF], axis=1)\n",
    "ALL_LABELS  = CLEAN_DF['LABEL']\n",
    "ALL_VENDORS = CLEAN_DF['vendorId']\n",
    "\n",
    "(\n",
    "    TEXT_TRAIN, TEXT_TEST,\n",
    "    NUMERIC_TRAIN, NUMERIC_TEST,\n",
    "    VENDOR_TRAIN, VENDOR_TEST,\n",
    "    LABELS_TRAIN, LABELS_TEST\n",
    ") = train_test_split(\n",
    "    ALL_TEXT, ALL_NUMERIC, ALL_VENDORS, ALL_LABELS,\n",
    "    test_size=TEST_SPLIT_FRACTION,\n",
    "    random_state=RANDOM_SEED,\n",
    "    stratify=STRATIFY_LABEL\n",
    ")\n",
    "\n",
    "print(f'Training samples : {len(LABELS_TRAIN):,}')\n",
    "print(f'Test samples     : {len(LABELS_TEST):,}')\n",
    "print(f'Classes in train : {LABELS_TRAIN.nunique()}')\n",
    "print(f'Classes in test  : {LABELS_TEST.nunique()}')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.2 Feature Matrix Construction\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# WORD TF-IDF  (1–2 grams, 15k features)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "TFIDF_WORD = TfidfVectorizer(\n",
    "    ngram_range=TFIDF_WORD_NGRAM_RANGE,\n",
    "    max_features=TFIDF_WORD_MAX_FEATURES,\n",
    "    sublinear_tf=True,   # apply log(1 + tf) — reduces dominance of very frequent terms\n",
    "    min_df=1,\n",
    "    token_pattern=r'(?u)\\b\\w\\w+\\b'\n",
    ")\n",
    "\n",
    "TFIDF_WORD_TRAIN = TFIDF_WORD.fit_transform(TEXT_TRAIN)\n",
    "TFIDF_WORD_TEST  = TFIDF_WORD.transform(TEXT_TEST)\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# CHAR TF-IDF  (2–4 char n-grams, 10k features)\n",
    "# Catches morphological patterns: \"subscri\" in subscription, \"recr\" in recruiter\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "TFIDF_CHAR = TfidfVectorizer(\n",
    "    ngram_range=TFIDF_CHAR_NGRAM_RANGE,\n",
    "    max_features=TFIDF_CHAR_MAX_FEATURES,\n",
    "    sublinear_tf=True,\n",
    "    min_df=1,\n",
    "    analyzer='char_wb'  # character n-grams with word boundaries respected\n",
    ")\n",
    "\n",
    "TFIDF_CHAR_TRAIN = TFIDF_CHAR.fit_transform(TEXT_TRAIN)\n",
    "TFIDF_CHAR_TEST  = TFIDF_CHAR.transform(TEXT_TEST)\n",
    "\n",
    "# Combined text features\n",
    "TFIDF_COMBINED_TRAIN = hstack([TFIDF_WORD_TRAIN, TFIDF_CHAR_TRAIN])\n",
    "TFIDF_COMBINED_TEST  = hstack([TFIDF_WORD_TEST,  TFIDF_CHAR_TEST])\n",
    "\n",
    "print(f'Word TF-IDF train shape : {TFIDF_WORD_TRAIN.shape}')\n",
    "print(f'Char TF-IDF train shape : {TFIDF_CHAR_TRAIN.shape}')\n",
    "print(f'Combined text shape     : {TFIDF_COMBINED_TRAIN.shape}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# VENDOR ONE-HOT ENCODING\n",
    "#\n",
    "# Key insight from EDA: ~60% of vendors always bill to the same account.\n",
    "# One-hot encoding the top N vendors lets the model learn these direct mappings.\n",
    "# We build the list of top vendors from TRAINING data only to prevent leakage.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "TOP_VENDOR_IDS = VENDOR_TRAIN.value_counts().head(TOP_N_VENDORS_ONE_HOT).index.tolist()\n",
    "\n",
    "def build_vendor_onehot_matrix(VENDOR_SERIES: pd.Series, TOP_VENDOR_LIST: list) -> csr_matrix:\n",
    "    \"\"\"Build a sparse one-hot matrix for vendor identity.\n",
    "\n",
    "    Rows correspond to records; columns correspond to each top vendor.\n",
    "    Unknown vendors (not in the top list) get an all-zero row.\n",
    "    \"\"\"\n",
    "    VENDOR_INDEX_MAP  = {VID: IDX for IDX, VID in enumerate(TOP_VENDOR_LIST)}\n",
    "    N_ROWS            = len(VENDOR_SERIES)\n",
    "    N_COLS            = len(TOP_VENDOR_LIST)\n",
    "    MATRIX            = np.zeros((N_ROWS, N_COLS), dtype=np.float32)\n",
    "\n",
    "    for ROW_IDX, VENDOR_ID in enumerate(VENDOR_SERIES.values):\n",
    "        if VENDOR_ID in VENDOR_INDEX_MAP:\n",
    "            MATRIX[ROW_IDX, VENDOR_INDEX_MAP[VENDOR_ID]] = 1.0\n",
    "\n",
    "    return csr_matrix(MATRIX)\n",
    "\n",
    "\n",
    "VENDOR_OH_TRAIN = build_vendor_onehot_matrix(VENDOR_TRAIN, TOP_VENDOR_IDS)\n",
    "VENDOR_OH_TEST  = build_vendor_onehot_matrix(VENDOR_TEST,  TOP_VENDOR_IDS)\n",
    "\n",
    "print(f'Vendor one-hot train shape : {VENDOR_OH_TRAIN.shape}')\n",
    "print(f'Top {TOP_N_VENDORS_ONE_HOT} vendors cover {VENDOR_TRAIN.isin(TOP_VENDOR_IDS).mean()*100:.1f}% of training records')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# NUMERIC FEATURES  — scale and convert to sparse for hstack compatibility\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "NUMERIC_SCALER      = StandardScaler()\n",
    "NUMERIC_TRAIN_SCALED = csr_matrix(NUMERIC_SCALER.fit_transform(NUMERIC_TRAIN))\n",
    "NUMERIC_TEST_SCALED  = csr_matrix(NUMERIC_SCALER.transform(NUMERIC_TEST))\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# FINAL FEATURE MATRIX  — stack all feature groups horizontally\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "X_TRAIN_FULL = hstack([TFIDF_COMBINED_TRAIN, NUMERIC_TRAIN_SCALED, VENDOR_OH_TRAIN])\n",
    "X_TEST_FULL  = hstack([TFIDF_COMBINED_TEST,  NUMERIC_TEST_SCALED,  VENDOR_OH_TEST])\n",
    "\n",
    "print(f'Final train feature matrix : {X_TRAIN_FULL.shape}')\n",
    "print(f'Final test  feature matrix : {X_TEST_FULL.shape}')\n",
    "print(f'  — {TFIDF_COMBINED_TRAIN.shape[1]} text features')\n",
    "print(f'  — {NUMERIC_TRAIN_SCALED.shape[1]} numeric features')\n",
    "print(f'  — {VENDOR_OH_TRAIN.shape[1]} vendor one-hot features')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.3 Logistic Regression\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# LOGISTIC REGRESSION\n",
    "#\n",
    "# Why: LR on sparse TF-IDF is a well-known strong baseline for text classification.\n",
    "# class_weight='balanced' compensates for the skewed class distribution.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "print('Training Logistic Regression ...')\n",
    "\n",
    "LR_MODEL = LogisticRegression(\n",
    "    C=LR_REGULARISATION_C,\n",
    "    max_iter=LR_MAX_ITERATIONS,\n",
    "    solver='lbfgs',\n",
    "    multi_class='multinomial',\n",
    "    class_weight='balanced',\n",
    "    random_state=RANDOM_SEED,\n",
    "    n_jobs=-1\n",
    ")\n",
    "LR_MODEL.fit(X_TRAIN_FULL, LABELS_TRAIN)\n",
    "\n",
    "LR_PREDICTIONS   = LR_MODEL.predict(X_TEST_FULL)\n",
    "LR_ACCURACY      = accuracy_score(LABELS_TEST, LR_PREDICTIONS)\n",
    "\n",
    "print(f'Logistic Regression accuracy : {LR_ACCURACY:.4f}  ({LR_ACCURACY*100:.2f}%)')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.4 Linear SVC\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# LINEAR SVC\n",
    "#\n",
    "# Why: LinearSVC often beats LR on text classification by finding a larger-margin\n",
    "# decision boundary. class_weight='balanced' handles class imbalance.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "print('Training Linear SVC ...')\n",
    "\n",
    "SVC_MODEL = LinearSVC(\n",
    "    C=SVC_REGULARISATION_C,\n",
    "    max_iter=SVC_MAX_ITERATIONS,\n",
    "    class_weight='balanced',\n",
    "    random_state=RANDOM_SEED\n",
    ")\n",
    "SVC_MODEL.fit(X_TRAIN_FULL, LABELS_TRAIN)\n",
    "\n",
    "SVC_PREDICTIONS  = SVC_MODEL.predict(X_TEST_FULL)\n",
    "SVC_ACCURACY     = accuracy_score(LABELS_TEST, SVC_PREDICTIONS)\n",
    "\n",
    "print(f'Linear SVC accuracy          : {SVC_ACCURACY:.4f}  ({SVC_ACCURACY*100:.2f}%)')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.5 LightGBM\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# LIGHTGBM  (GPU-accelerated gradient boosting)\n",
    "#\n",
    "# Why: Gradient boosting on TF-IDF features can capture non-linear interactions\n",
    "# that linear models miss. class_weight='balanced' handles imbalance.\n",
    "# Falls back to CPU if GPU driver is unavailable.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "if HAS_LIGHTGBM:\n",
    "    print('Training LightGBM ...')\n",
    "\n",
    "    LGBM_MODEL = lgb.LGBMClassifier(\n",
    "        n_estimators=LGBM_N_ESTIMATORS,\n",
    "        learning_rate=LGBM_LEARNING_RATE,\n",
    "        num_leaves=LGBM_NUM_LEAVES,\n",
    "        subsample=0.8,\n",
    "        colsample_bytree=0.8,\n",
    "        class_weight='balanced',\n",
    "        random_state=RANDOM_SEED,\n",
    "        device='gpu',    # uses NVIDIA GPU if available; falls back to CPU automatically\n",
    "        verbose=-1,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "\n",
    "    try:\n",
    "        LGBM_MODEL.fit(X_TRAIN_FULL, LABELS_TRAIN)\n",
    "        print('  trained on GPU')\n",
    "    except Exception as LGBM_ERROR:\n",
    "        print(f'  GPU unavailable ({LGBM_ERROR}), retrying on CPU')\n",
    "        LGBM_MODEL.set_params(device='cpu')\n",
    "        LGBM_MODEL.fit(X_TRAIN_FULL, LABELS_TRAIN)\n",
    "\n",
    "    LGBM_PREDICTIONS = LGBM_MODEL.predict(X_TEST_FULL)\n",
    "    LGBM_ACCURACY    = accuracy_score(LABELS_TEST, LGBM_PREDICTIONS)\n",
    "    print(f'LightGBM accuracy            : {LGBM_ACCURACY:.4f}  ({LGBM_ACCURACY*100:.2f}%)')\n",
    "else:\n",
    "    LGBM_ACCURACY    = 0.0\n",
    "    LGBM_PREDICTIONS = None\n",
    "    print('LightGBM not available — skipped')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.6 Model Comparison and Selection\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# COMPARE ALL MODELS  — pick the one with highest test accuracy\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "MODEL_REGISTRY = {\n",
    "    'Logistic Regression': (LR_MODEL,  LR_PREDICTIONS,   LR_ACCURACY),\n",
    "    'Linear SVC'         : (SVC_MODEL, SVC_PREDICTIONS,  SVC_ACCURACY),\n",
    "}\n",
    "if HAS_LIGHTGBM and LGBM_PREDICTIONS is not None:\n",
    "    MODEL_REGISTRY['LightGBM'] = (LGBM_MODEL, LGBM_PREDICTIONS, LGBM_ACCURACY)\n",
    "\n",
    "print('Model comparison:')\n",
    "print('─' * 50)\n",
    "\n",
    "BEST_MODEL_NAME   = None\n",
    "BEST_MODEL_OBJ    = None\n",
    "BEST_PREDICTIONS  = None\n",
    "BEST_ACCURACY     = 0.0\n",
    "\n",
    "for MODEL_NAME, (MODEL_OBJ, MODEL_PREDS, MODEL_ACC) in sorted(\n",
    "    MODEL_REGISTRY.items(), key=lambda ITEM: -ITEM[1][2]\n",
    "):\n",
    "    IS_BEST = MODEL_ACC == max(V[2] for V in MODEL_REGISTRY.values())\n",
    "    MARKER  = '  <- BEST' if IS_BEST else ''\n",
    "    print(f'  {MODEL_NAME:25s} : {MODEL_ACC:.4f}  ({MODEL_ACC*100:.2f}%){MARKER}')\n",
    "    if MODEL_ACC > BEST_ACCURACY:\n",
    "        BEST_MODEL_NAME, BEST_MODEL_OBJ, BEST_PREDICTIONS, BEST_ACCURACY = (\n",
    "            MODEL_NAME, MODEL_OBJ, MODEL_PREDS, MODEL_ACC\n",
    "        )\n",
    "\n",
    "print('─' * 50)\n",
    "print(f'\\nSelected : {BEST_MODEL_NAME}')\n",
    "print(f'Accuracy : {BEST_ACCURACY:.4f}  ({BEST_ACCURACY*100:.2f}%)')\n",
    "print(f'Target {ACCURACY_TARGET*100:.0f}% met : {\"YES\" if BEST_ACCURACY >= ACCURACY_TARGET else \"NO\"}')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.7 Cross-Validation\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# 5-FOLD STRATIFIED CROSS-VALIDATION\n",
    "#\n",
    "# Cross-validation on the full dataset gives a more reliable accuracy estimate\n",
    "# than a single 80/20 split, since it averages across 5 different test folds.\n",
    "#\n",
    "# We rebuild the TF-IDF + vendor features inside the loop implicitly by\n",
    "# using a Pipeline object — this is the correct way to avoid leakage across folds.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "from sklearn.pipeline import Pipeline\n",
    "\n",
    "# Rebuild combined text features for the full dataset (for CV)\n",
    "TFIDF_WORD_FULL   = TfidfVectorizer(\n",
    "    ngram_range=TFIDF_WORD_NGRAM_RANGE,\n",
    "    max_features=TFIDF_WORD_MAX_FEATURES,\n",
    "    sublinear_tf=True, min_df=1,\n",
    "    token_pattern=r'(?u)\\b\\w\\w+\\b'\n",
    ")\n",
    "TFIDF_CHAR_FULL   = TfidfVectorizer(\n",
    "    ngram_range=TFIDF_CHAR_NGRAM_RANGE,\n",
    "    max_features=TFIDF_CHAR_MAX_FEATURES,\n",
    "    sublinear_tf=True, min_df=1,\n",
    "    analyzer='char_wb'\n",
    ")\n",
    "X_WORD_ALL = TFIDF_WORD_FULL.fit_transform(ALL_TEXT)\n",
    "X_CHAR_ALL = TFIDF_CHAR_FULL.fit_transform(ALL_TEXT)\n",
    "X_TEXT_ALL = hstack([X_WORD_ALL, X_CHAR_ALL])\n",
    "\n",
    "# Numeric features for full dataset\n",
    "SCALER_FULL  = StandardScaler()\n",
    "X_NUM_ALL    = csr_matrix(SCALER_FULL.fit_transform(ALL_NUMERIC))\n",
    "\n",
    "# Vendor one-hot for full dataset\n",
    "ALL_TOP_VENDORS  = ALL_VENDORS.value_counts().head(TOP_N_VENDORS_ONE_HOT).index.tolist()\n",
    "X_VENDOR_ALL     = build_vendor_onehot_matrix(ALL_VENDORS, ALL_TOP_VENDORS)\n",
    "\n",
    "X_ALL_COMBINED   = hstack([X_TEXT_ALL, X_NUM_ALL, X_VENDOR_ALL])\n",
    "Y_ALL_LABELS     = ALL_LABELS.values\n",
    "\n",
    "# Run CV with the best model architecture (recreate fresh estimator to avoid state issues)\n",
    "CV_ESTIMATOR = LinearSVC(\n",
    "    C=SVC_REGULARISATION_C,\n",
    "    max_iter=SVC_MAX_ITERATIONS,\n",
    "    class_weight='balanced',\n",
    "    random_state=RANDOM_SEED\n",
    ")\n",
    "\n",
    "STRAT_KF     = StratifiedKFold(n_splits=CV_N_FOLDS, shuffle=True, random_state=RANDOM_SEED)\n",
    "CV_SCORES    = cross_val_score(\n",
    "    CV_ESTIMATOR, X_ALL_COMBINED, Y_ALL_LABELS,\n",
    "    cv=STRAT_KF, scoring='accuracy', n_jobs=-1\n",
    ")\n",
    "\n",
    "print(f'{CV_N_FOLDS}-fold Stratified CV Accuracy scores:')\n",
    "for FOLD_NUM, FOLD_SCORE in enumerate(CV_SCORES, 1):\n",
    "    print(f'  Fold {FOLD_NUM}: {FOLD_SCORE:.4f}')\n",
    "print(f'\\nMean  : {CV_SCORES.mean():.4f}  ({CV_SCORES.mean()*100:.2f}%)')\n",
    "print(f'StdDev: {CV_SCORES.std():.4f}')\n",
    "print(f'Target {ACCURACY_TARGET*100:.0f}% met : {\"YES\" if CV_SCORES.mean() >= ACCURACY_TARGET else \"NO\"}')\n"
   ]
  },
