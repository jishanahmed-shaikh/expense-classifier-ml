  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 6.2 Per-Category Performance\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# PER-CLASS METRICS  — find the best and worst performing categories\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "REPORT_DICT   = classification_report(\n",
    "    TRUE_CLASS_NAMES, PRED_CLASS_NAMES,\n",
    "    output_dict=True, zero_division=0\n",
    ")\n",
    "\n",
    "# Filter out the macro/weighted summary rows\n",
    "SUMMARY_KEYS  = {'accuracy', 'macro avg', 'weighted avg'}\n",
    "PER_CLASS_DF  = pd.DataFrame({\n",
    "    CLASS_NAME: METRICS\n",
    "    for CLASS_NAME, METRICS in REPORT_DICT.items()\n",
    "    if CLASS_NAME not in SUMMARY_KEYS\n",
    "}).T\n",
    "\n",
    "PER_CLASS_DF  = PER_CLASS_DF.rename(columns={'f1-score': 'f1'})\n",
    "PER_CLASS_DF  = PER_CLASS_DF.astype({'precision': float, 'recall': float, 'f1': float, 'support': int})\n",
    "PER_CLASS_DF  = PER_CLASS_DF[PER_CLASS_DF['support'] > 0].sort_values('f1', ascending=False)\n",
    "\n",
    "print('Top 10 best-performing categories (by F1):')\n",
    "print(PER_CLASS_DF.head(10).to_string())\n",
    "print()\n",
    "print('Bottom 10 worst-performing categories (by F1):')\n",
    "print(PER_CLASS_DF.tail(10).to_string())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
